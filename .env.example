# ============================================
# TiKiTI - Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# cp .env.example .env

# ============================================
# Supabase (Database)
# ============================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ============================================
# Paystack (Payments)
# ============================================
PAYSTACK_SECRET_KEY=sk_test_your-secret-key-here
VITE_PAYSTACK_PUBLIC_KEY=pk_test_your-public-key-here

# ============================================
# JWT Authentication
# ============================================
# Generate a strong random string (min 32 chars)
JWT_SECRET=your-jwt-secret-min-32-chars-long-and-secure

# ============================================
# QR Code Security
# ============================================
# Used for HMAC-signing QR codes (forgery prevention)
QR_HMAC_SECRET=your-qr-hmac-secret-change-in-production

# ============================================
# Application
# ============================================
VITE_API_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000
NODE_ENV=development
PORT=3001
HOST=0.0.0.0
